# Copy this file to .env and fill real values. NEVER commit .env to git.
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=videocall_app
SECRET_KEY=change-this-to-a-long-random-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
UPLOAD_DIR=static/uploads
MAX_FILE_SIZE=10485760
MAX_VIDEO_SIZE=104857600

# ---- AI chat bot (optional) — any OpenAI-compatible API ----
# Khali chhodo toh built-in Hindi/English/Hinglish fallback bot chalega.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
